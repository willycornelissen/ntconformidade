{
  "name": "ntconformidade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "node scripts/workspace-runner.mjs typecheck",
    "lint": "eslint .",
    "build": "npm run typecheck && node scripts/workspace-runner.mjs build",
    "test": "node --test tests/*.test.mjs && node scripts/workspace-runner.mjs test",
    "dev:desktop": "npm run dev --workspace=packages/desktop --if-present",
    "package:win": "npm run build && npm run package:win --workspace=packages/desktop --if-present",
    "package:linux": "npm run build && npm run package:linux --workspace=packages/desktop --if-present",
    "rebuild:electron": "npm run rebuild --workspace=packages/desktop --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
