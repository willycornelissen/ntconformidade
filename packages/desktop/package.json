{
  "name": "@ntc/desktop",
  "version": "0.1.0",
  "description": "Aplicativo Electron NT Conformidade (SEF/MG)",
  "author": "SEF/MG Integracao",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.preload.json",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.preload.json",
    "dev": "npm run build && electron dist/main.js",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@ntc/core": "0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/node": "^22.13.10",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
